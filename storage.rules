rules_version = '2';

/* Content uploaded to learn from — same ownership model as Firestore: the
   authenticated adult (parent/teacher) owns everything under their own uid,
   nobody else can read or write it. A selected child is metadata, not a
   separate security principal — see firestore.rules and CLAUDE.md
   "Kindergarten & the adult-authenticates, child-selects model". No adult
   READ path from a different account reaches this bucket at all. */

service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{childId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
