# Firebase web config.
#
# Committed on purpose. A Firebase web API key is an identifier, not a
# credential: it names the project, it does not authorize anything. Access is
# controlled by Firestore security rules and Auth, both of which are enforced
# server-side. Google documents these values as safe to expose, and they ship
# in the client bundle regardless.
#
# spec.md N20 requires a public repo with a one-command deploy, which is not
# possible if a cloner has to invent this file.
#
# NOTHING SECRET GOES IN THIS FILE. The NVIDIA and Anthropic keys are
# server-side only and live in Firebase Functions secrets. See HANDOFF.md.
#
# measurementId is intentionally absent — no Analytics (hard rule 8).

VITE_FIREBASE_API_KEY=AIzaSyAyv_ZmtBcLrfjdL8k7g1yqJfKNC1aXkvo
VITE_FIREBASE_AUTH_DOMAIN=bloom-aba.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bloom-aba
VITE_FIREBASE_STORAGE_BUCKET=bloom-aba.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=282766104566
VITE_FIREBASE_APP_ID=1:282766104566:web:63f751e5f05939451a19d7

# Set to true in .env.local to point callables at the local emulator.
VITE_USE_EMULATOR=false
